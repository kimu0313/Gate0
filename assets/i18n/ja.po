msgstr "先へ進む"

msgid "열쇠 줍기"
msgstr "鍵を拾う"

msgid "열쇠를 주웠다."
msgstr "鍵を拾った。"

msgid "열쇠로 자물쇠 열기"
msgstr "鍵で南京錠を開ける"

msgid "자물쇠 열기"
msgstr "南京錠を開ける"

msgid "열쇠 찾기"
msgstr "鍵を探す"

msgid "문 너머로 나아가기"
msgstr "扉の向こうへ進む"

msgid "조명 설비"
msgstr "照明設備"

msgid "안내방송 설비"
msgstr "案内放送設備"

msgid "수하물 운송 설비"
msgstr "手荷物搬送設備"

msgid "직원 통로"
msgstr "職員通路"

msgid "수하물 운송 설비 확인"
msgstr "手荷物搬送設備の確認"

msgid "A국제공항 터미널"
msgstr "A国際空港ターミナル"

msgid "정상 근무"
msgstr "通常勤務"

msgid "태블릿으로 점검 목록 확인하기  [Tab]"
msgstr "タブレットで点検リストを確認する  [Tab]"

msgid "수하물 운송 설비 확인하기"
msgstr "手荷物搬送設備を確認する"

msgid "[F] 손전등을 켜고 끌 수 있습니다."
msgstr "[F] で懐中電灯をつけたり消したりできます。"

msgid "소리가 난 곳 확인하기"
msgstr "音のした場所を確かめる"

msgid "종잇조각 살펴보기"
msgstr "紙切れを調べる"

msgid "저 사람에게 말 걸기"
msgstr "あの人に話しかける"

msgid "다시 말 걸기"
msgstr "もう一度話しかける"

msgid "손전등으로 얼굴 확인하기"
msgstr "懐中電灯で顔を確かめる"

msgid "도망쳐라"
msgstr "逃げろ"

msgid "[SHIFT] 달리기"
msgstr "[SHIFT] 走る"

