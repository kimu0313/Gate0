msgid "%s 씨. %s 씨, 들립니까. 여기는, 에이영편입니다."
msgstr "%sさん。%sさん、聞こえますか。こちらは、A0便です。"

msgid "A0편 DEPARTED"
msgstr "A0便 DEPARTED"

msgid "전광판 맨 위에 없는 항공편 A0(23:40 · GATE 0)이 DEPARTED로 떠 있었습니다."
msgstr "案内板の一番上に、存在しない便A0（23:40 · GATE 0）がDEPARTEDと表示されていました。"

msgid "젖은 가방"
msgstr "濡れたバッグ"

msgid "바닷물에 젖은 1980년대 가죽 가방(A0 · 87.11.03 태그)이 함께 나왔습니다."
msgstr "海水に濡れた1980年代の革のバッグ（A0 · 87.11.03のタグ）が一緒に出てきました。"

msgid "바닷물에 젖은 가방에 손을 댔습니다. (수칙 p.5)"
msgstr "海水に濡れたバッグに触れました。（規則 p.5）"

msgid "41개의 소지품"
msgstr "41個の所持品"

msgid "가방 하나를 넣었는데 승객 소지품 41개가 연달아 통과했습니다. 태그는 모두 A0 · 87.11.03."
msgstr "バッグを一つ入れただけなのに、乗客の所持品が41個、次々と通過しました。タグはすべて A0 · 87.11.03。"

msgid "승객 소지품이 연달아 찍히는 X-ray 모니터를 껐습니다. (수칙 p.7)"
msgstr "乗客の所持品が次々と映るX線モニターを消しました。（規則 p.7）"

msgid "위치: 보안검색 구역 1번 레인 / 판독 모니터는 기계 동쪽 데스크\n\n[b][정상][/b] [가방 투입] 시 판독 화면: 노트북, 물병, 열쇠, 케이블.\n\n① 판독 화면에 [b]사람의 형체[/b]가 보이면:\n　→ 모니터를 끄지 마십시오.\n　→ 화면 앞에서 [b]눈을 감고 10초[/b]를 세십시오. 형체와 눈을 마주치지 마십시오.\n\n② 가방 속에서 무언가 [b]규칙적으로 움직이면[/b]:\n　→ X-ray [비상정지]를 누르십시오. 모니터를 끄지 마십시오.\n\n③ 판독 화면의 가방에 [b]승객 이름표[/b]가 보이면:\n　→ 그 이름을 소리 내어 읽지 마십시오.\n　→ X-ray [b][비상정지][/b]를 누르십시오. 모니터를 끄지 마십시오.\n\n④ 한 번 투입했는데 가방이 [b]연달아[/b] 통과하면:\n　→ 개수를 세지 마십시오.\n　→ X-ray [b][비상정지][/b]를 누르십시오. 모니터를 끄지 마십시오."
msgstr "場所：保安検査エリア 1番レーン／判読モニターは機械東側のデスク\n\n[b][正常][/b] [バッグ投入 / 가방 투입]時の判読画面：ノートパソコン、水筒、鍵、ケーブル。\n\n① 判読画面に[b]人の形[/b]が見えた場合：\n　→ モニターを切らないでください。\n　→ 画面の前で[b]目を閉じて10秒[/b]数えてください。その形と目を合わせないでください。\n\n② バッグの中で何かが[b]規則的に動いている[/b]場合：\n　→ X線の[非常停止 / 비상정지]を押してください。モニターを切らないでください。\n\n③ 判読画面のバッグに[b]乗客の名札[/b]が見えた場合：\n　→ その名前を声に出して読まないでください。\n　→ X線の[b][非常停止 / 비상정지][/b]を押してください。モニターを切らないでください。\n\n④ 一度投入しただけなのに、バッグが[b]次々と[/b]通過した場合：\n　→ 個数を数えないでください。\n　→ X線の[b][非常停止 / 비상정지][/b]を押してください。モニターを切らないでください。"

msgid "채용 공고 — 게시 이력"
msgstr "求人 — 掲載履歴"

msgid "서해국제공항공사 채용 게시판\n\n[계약직] 터미널 새벽 시설점검원 (00:00 ~ 06:00) · 1명\n지원자 %s — 최종 합격 · 10월 19일 첫 근무 배정\n\n[b]게시 이력[/b]\n2026. 08. 31. 게시　　　 → 09. 06. 채용 완료\n2026. 09. 07. 재게시　　 → 09. 13. 채용 완료\n2026. 09. 14. 재게시　　 → 09. 20. 채용 완료\n2026. 09. 21. 재게시　　 → 09. 27. 채용 완료\n2026. 09. 28. 재게시　　 → 10. 04. 채용 완료\n2026. 10. 05. 재게시　　 → 10. 11. 채용 완료\n2026. 10. 12. 재게시　　 → 10. 18. 채용 완료\n2026. 10. 26. 재게시 예약 (자동)\n\n※ 이 공고는 근무자가 바뀔 때마다 자동으로 다시 게시됩니다."
msgstr "西海国際空港公社 採用掲示板\n\n[契約社員] ターミナル深夜施設点検員（00:00 ~ 06:00）· 1名\n応募者 %s — 最終合格 · 10月19日 初勤務に配置\n\n[b]掲載履歴[/b]\n2026. 08. 31. 掲載　　　 → 09. 06. 採用決定\n2026. 09. 07. 再掲載　　 → 09. 13. 採用決定\n2026. 09. 14. 再掲載　　 → 09. 20. 採用決定\n2026. 09. 21. 再掲載　　 → 09. 27. 採用決定\n2026. 09. 28. 再掲載　　 → 10. 04. 採用決定\n2026. 10. 05. 再掲載　　 → 10. 11. 採用決定\n2026. 10. 12. 再掲載　　 → 10. 18. 採用決定\n2026. 10. 26. 再掲載予約（自動）\n\n※ この求人は、勤務者が替わるたびに自動で再掲載されます。"

msgid "사물함 04 — 이름표"
msgstr "ロッカー04 — 名札"

msgid "맨 위에 새 이름표가 붙어 있다.\n　「%s」\n\n그 아래로 이름표가 여러 겹 덧붙어 있다.\n들뜬 가장자리마다 다른 이름이 보인다.\n　「박정우」　「이수연」　「김도현」　「최은비」　「한 ○ ○」\n\n몇 장은 볼펜으로 그어져 있다.\n맨 아래 한 장은 누렇게 바랬다 — 「서해비행장 정비과」"
msgstr "一番上に、新しい名札が貼ってある。\n　「%s」\n\nその下に、名札が何枚も重ねて貼られている。\n浮いた縁ごとに、違う名前が見える。\n　「パク・ジョンウ」　「イ・スヨン」　「キム・ドヒョン」　「チェ・ウンビ」　「ハン・○○」\n\n何枚かはボールペンで線が引かれている。\n一番下の一枚は黄ばんでいる — 「西海飛行場 整備課」"

msgid "10월 12일.\n첫 근무. 소장님은 무전으로만 연락한다. 얼굴은 한 번도 못 봤다.\n\n수칙이 이상할 정도로 구체적이다.\n'0번 게이트는 존재하지 않습니다.'\n존재하지 않는 걸 왜 굳이 적어 놨을까.\n\n그래도 시키는 대로만 하면 아무 일도 없다고 했다."
msgstr "10月12日。\n初勤務。所長は無線でしか連絡してこない。顔は一度も見たことがない。\n\n規則が妙なほど具体的だ。\n「0番ゲートは存在しません。」\n存在しないものを、なぜわざわざ書いておいたのだろう。\n\nそれでも、言われた通りにさえしていれば何も起きないそうだ。"

msgid "새벽 3시쯤 전광판이 혼자 켜짐.\n편명 A0, 목적지 칸 비어 있음, 게이트 0.\n삭제해도 다음 날 또 뜸.\n\n소장님은 신경 쓰지 말라고 함.\n— 전기팀 박"
msgstr "午前3時ごろ、案内板がひとりでに点灯。\n便名A0、行き先欄は空白、ゲート0。\n削除しても翌日また表示。\n\n所長は気にするなとのこと。\n— 電気チーム 朴"

msgid "분실물 — 탑승권 (1987)"
msgstr "遺失物 — 搭乗券（1987）"

msgid "서해비행장 · BOARDING PASS\n\n편명　　 A0\n날짜　　 1987. 11. 03.\n출발　　 23:40\n탑승구　 0\n좌석　　 —\n성명　　 (잉크가 번져 읽을 수 없다)\n\n분실물 보관 태그\n접수 2026. 10. 19. 05:58 · 접수자 —\n\n아직 개장도 하지 않은 공항이다."
msgstr "西海飛行場 · BOARDING PASS\n\n便名　　 A0\n日付　　 1987年11月3日\n出発　　 23:40\n搭乗口　 0\n座席　　 —\n氏名　　 （インクがにじんで読めない）\n\n遺失物保管タグ\n受付 2026年10月19日 05:58 · 受付者 —\n\nまだ開港すらしていない空港だ。"

msgid "녹슨 추모 동판"
msgstr "錆びた追悼銘板"

msgid "추　모\n\n1987년 11월\n서해비행장 A0편\n탑승객 41명\n\n(이름이 새겨진 아랫부분은 녹이 슬어 읽을 수 없다)\n\n모서리가 휘고 녹이 번져 있다.\n새로 지은 터미널에는 어울리지 않을 만큼 오래된 동판이다."
msgstr "追　悼\n\n1987年11月\n西海飛行場 A0便\n乗客41名\n\n（名前が刻まれた下の部分は、錆びて読めない）\n\n角が曲がり、錆が広がっている。\n新しく建てたターミナルには似合わないほど、古い銅板だ。"

msgid "문서관리시스템 — 검색: A0"
msgstr "文書管理システム — 検索：A0"

msgid "서해국제공항공사 문서관리시스템\n검색어: A0　　결과 2건\n\n[1] 사고 조사 보고서 — 서해비행장 A0편 (1987)\n　　작성자: —　　작성일: —\n　　본문: (공란)\n\n[2] 내부 문서 SH-87-1103\n　　「A0 관련, 관계자 외 열람 금지」\n　　열람 권한이 없습니다."
msgstr "西海国際空港公社 文書管理システム\n検索語：A0　　結果 2件\n\n[1] 事故調査報告書 — 西海飛行場 A0便（1987）\n　　作成者：—　　作成日：—\n　　本文：（空欄）\n\n[2] 内部文書 SH-87-1103\n　　「A0関連、関係者以外閲覧禁止」\n　　閲覧権限がありません。"

msgid "PA-01 자가 진단"
msgstr "PA-01 自己診断"

msgid "PA-01 SELF TEST　　　　 FAULT\n\nSPK-07 (체크인 홀 동측) ········ 출력 없음\nAMP-2 ································ 이상\n\n예비 모듈 보관 위치\n　자재창고 · 이관 설비 상자\n\n※ 모듈 교체 후 콘솔이 자동으로 재시작됩니다."
msgstr "PA-01 SELF TEST　　　　 FAULT\n\nSPK-07（チェックインホール東側）········ 出力なし\nAMP-2 ································ 異常\n\n予備モジュール保管場所\n　資材倉庫 · 移管設備の箱\n\n※ モジュール交換後、コンソールは自動的に再起動します。"

msgid "이관 설비 목록"
msgstr "移管設備一覧"

msgid "구 A비행장 설비 — 재사용\n(서해비행장 → 서해국제공항 이관 · 2025. 03.)\n\n1. 방송 콘솔 PA-01 ··············· 재사용 (안내 데스크)\n2. 스피커 SPK-01 ~ 12 ············ 일부 재사용 (체크인 홀)\n3. 방송용 테이프 데크 ············· 콘솔 내장\n4. 예비 앰프 모듈 AMP-2 ··········· 보관\n5. 관제 교신 녹음 테이프 1개 ······ 폐기 예정 → 보류\n6. 출발 안내 표시기 ··············· 폐기\n\n비고: 콘솔 음질 이상 없음. 그대로 사용할 것."
msgstr "旧A飛行場設備 — 再使用\n（西海飛行場 → 西海国際空港 移管 · 2025. 03.）\n\n1. 放送コンソール PA-01 ··············· 再使用（案内カウンター）\n2. スピーカー SPK-01 ~ 12 ············ 一部再使用（チェックインホール）\n3. 放送用テープデッキ ············· コンソール内蔵\n4. 予備アンプモジュール AMP-2 ··········· 保管\n5. 管制交信録音テープ 1本 ······ 廃棄予定 → 保留\n6. 出発案内表示器 ··············· 廃棄\n\n備考：コンソールの音質に異常なし。そのまま使用すること。"

msgid "신문 스크랩 묶음 (1987)"
msgstr "新聞の切り抜きの束（1987）"

msgid "누렇게 바랜 기사 조각들이 날짜순으로 붙어 있다.\n누군가 꾸준히 모아 온 것이다.\n\n11. 05.　서해비행장發 A0편 교신 두절… 해경 수색 착수\n11. 10.　A0편 수색 1주째, 서해상 표류물 없어\n11. 17.　서해상 A0편 수색 2주째… 탑승객 41명 생사 불명\n11. 24.　서해상 A0편 수색 3주째… 잔해도 기름띠도 없어\n11. 26.　A0편 수색 종료\n\n마지막 기사 여백에 볼펜 글씨:\n「도착 안내라도 듣고 싶다」 — 유족"
msgstr "黄ばんだ記事の切れ端が、日付順に貼られている。\n誰かがずっと集めてきたものだ。\n\n11. 05.　西海飛行場発A0便、交信途絶… 海洋警察が捜索に着手\n11. 10.　A0便の捜索1週間、西海上に漂流物なし\n11. 17.　西海上のA0便捜索2週間… 乗客41名の生死不明\n11. 24.　西海上のA0便捜索3週間… 残骸も油膜もなし\n11. 26.　A0便の捜索終了\n\n最後の記事の余白に、ボールペンの書き込み：\n「せめて到着案内だけでも聞きたい」 — 遺族"

msgid "공문 — 서해비행장 운항관리과 (1987)"
msgstr "公文書 — 西海飛行場 運航管理課（1987）"

msgid "문서번호 운항 87-1103\n수신: 교통부 항공국\n제목: A0편 수색 결과 보고\n\n1. 수색 기간: 1987. 11. 04. ~ 11. 25.\n2. 수색 결과: [b]발견물 없음.[/b]\n3. [b]기체 이륙 여부 재확인 요망.[/b]\n　 (관제 기록상 이륙 허가 23:40 · 교신 두절 23:44.\n　　활주로 감시 요원 중 이륙 장면을 본 사람 없음)\n\n붙임: 관제 교신 녹음 테이프 1부.　끝."
msgstr "文書番号 運航 87-1103\n宛先：交通部 航空局\n件名：A0便 捜索結果報告\n\n1. 捜索期間：1987年11月4日 ～ 11月25日\n2. 捜索結果：[b]発見物なし。[/b]\n3. [b]機体の離陸の有無について再確認を要する。[/b]\n　 （管制記録上、離陸許可 23:40 · 交信途絶 23:44。\n　　滑走路監視要員のうち、離陸の場面を見た者なし）\n\n添付：管制交信録音テープ 1部。　以上。"

msgid "어제 본 그 탑승권이다.\n\n종이가 흠뻑 젖어 있다. 짠 냄새가 난다 — 바닷물이다.\n보관함 안은 말라 있는데, 이것만 젖어 있다.\n\n편명　　 A0\n날짜　　 1987. 11. 03.\n출발　　 23:40\n성명　　 (번진 잉크 사이로 글자 몇 개가 새로 떠올라 있다)"
msgstr "昨日見た、あの搭乗券だ。\n\n紙がぐっしょり濡れている。塩の匂いがする — 海水だ。\n保管庫の中は乾いているのに、これだけが濡れている。\n\n便名　　 A0\n日付　　 1987年11月3日\n出発　　 23:40\n氏名　　 （にじんだインクの間から、いくつかの文字が新たに浮かび上がっている）"

msgid "성명: 박○○ (정비과)\n\n1987. 11. 03.　출근 23:02　　퇴근 ──\n1987. 11. 04.　출근 ──　　　 퇴근 ──\n\n(카드 뒷면, 연필 글씨)\nA0편 방송이 또 나온다.\n탑승 안내가 들리면 게이트에서 나와야 한다. 앉으면 끝이다."
msgstr "氏名: 朴○○ (整備課)\n\n1987. 11. 03.　出勤 23:02　　退勤 ──\n1987. 11. 04.　出勤 ──　　　 退勤 ──\n\n(カード裏面、鉛筆書き)\nA0便の放送がまた流れている。\n搭乗案内が聞こえたら、ゲートから出なければならない。座ったら終わりだ。"

msgid "녹슨 동판 살펴보기"
msgstr "錆びた銅板を調べる"

msgid "수칙 p.%s 챙기기"
msgstr "規則 p.%sを取る"

msgid "근무 수칙 p.%s %s — 바인더에 끼움"
msgstr "勤務規則 p.%s %s — バインダーに挟んだ"

msgid "10월 19일, 현재 시각 새벽 세 시입니다. 터미널 정기 안내 방송을 시작합니다."
msgstr "10月19日、ただいまの時刻、午前3時です。ターミナルの定時案内放送を開始いたします。"

msgid "1987년 11월 3일, 현재 시각 밤 11시 40분입니다. 터미널 정기 안내 방송을 시작합니다."
msgstr "1987年11月3日、ただいまの時刻、午後11時40分です。ターミナルの定時案内放送を開始いたします。"

msgid "10월 21일, 현재 시각 새벽 세 시입니다. 터미널 정기 안내 방송을 시작합니다."
msgstr "10月21日、ただいまの時刻、午前3時です。ターミナルの定時案内放送を開始いたします。"

msgid "10월 22일, 현재 시각 밤 11시 40분입니다. 서해비행장 정기 안내 방송을 시작합니다."
msgstr "10月22日、ただいまの時刻、午後11時40分です。西海飛行場の定時案内放送を開始いたします。"

msgid "10월 23일, 현재 시각 새벽 세 시입니다. 터미널 정기 안내 방송을 시작합니다."
msgstr "10月23日、ただいまの時刻、午前3時です。ターミナルの定時案内放送を開始いたします。"

msgid "마지막 수하물이 도착했습니다."
msgstr "最後の手荷物が到着いたしました。"

msgid "방송이 끝났다. …1987년 11월 3일, 밤 11시 40분이라고 했다."
msgstr "放送が終わった。…1987年11月3日、午後11時40分と言っていた。"

msgid "방송이 끝났다. …서해비행장. 그리고 마지막 수하물이 도착했다고 했다."
msgstr "放送が終わった。…西海飛行場。そして、最後の手荷物が到着したと言っていた。"

msgid "관제탑: A0, 서해 타워. 바람 잔잔, 활주로 34, 이륙을 허가합니다."
msgstr "管制塔：A0、西海タワー。風は穏やか、滑走路34、離陸を許可します。"

msgid "A0: 이륙 허가, 활주로 34. A0."
msgstr "A0：離陸許可、滑走路34。A0。"

msgid "A0: 서해 타워, A0. 이륙했습니다. 1,000피트 통과."
msgstr "A0：西海タワー、A0。離陸しました。1,000フィート通過。"

msgid "관제탑: A0, 레이더 포착. 6,000피트까지 상승하십시오."
msgstr "管制塔：A0、レーダー捕捉。6,000フィートまで上昇してください。"

msgid "A0: 6,000 상승, A0. …타워, 저기— 지금 아래에—"
msgstr "A0：6,000へ上昇、A0。…タワー、あの—— 今、下に——"

msgid "(잡음)"
msgstr "（雑音）"

msgid "…%s 씨. %s 씨, 들립니까. 여기는, A0편입니다."
msgstr "…%sさん。%sさん、聞こえますか。こちらは、A0便です。"

msgid "테이프가 이름을 부르는 동안 움직였습니다. (수칙 p.9 ②)"
msgstr "テープが名前を呼んでいる間に動きました。（規則 p.9 ②）"

msgid "잡음이 끊겼다. 스피커에서 테이프가 멈추는 소리가 났다."
msgstr "雑音が途切れた。スピーカーから、テープが止まる音がした。"

msgid "아, 또 새로 오신 분이네요."
msgstr "あ、また新しい方ですね。"

msgid "…아, 반가워요. 저는 저녁 근무예요. 오늘부터 새벽 근무 하시는 거죠?"
msgstr "…あ、よろしくお願いします。私は遅番です。今日から深夜勤務の方ですよね？"

msgid "들어가기 전에 저기 PC에서 근무 배정 확인 한 번 눌러 주세요. 인사팀에서 확인한대요."
msgstr "始める前に、あそこのPCで勤務配置の確認を一度押しておいてください。人事チームが確認するそうなので。"

msgid "사물함은 04번 쓰시면 돼요. 이름표 붙여 놨어요. 다 보고 오면 장비 넘겨 드릴게요."
msgstr "ロッカーは04番を使ってください。名札、貼っておきました。全部見てきたら、機材をお渡ししますね。"

msgid "확인했어요? 그럼 장비요. 이건 점검 태블릿. 점검 지시가 여기로 와요. [Tab]으로 열고, 보고도 여기서 해요."
msgstr "確認しました？ じゃあ機材です。これは点検タブレット。点検指示はここに届きます。[Tab]で開いて、報告もここでします。"

msgid "근무 수칙 바인더요. 아직 몇 장 없죠? 나머지 페이지는 시설마다 꽂혀 있어요. 갈 때마다 챙겨서 끼우면 돼요."
msgstr "勤務規則のバインダーです。まだ何枚もないでしょう？ 残りのページは施設ごとに置いてあります。行くたびに取って、挟んでいけばいいですよ。"

msgid "뭐… 얼마 지나면 못 보겠지만. 그래도 잘 부탁해요."
msgstr "まあ… そのうち会えなくなるんでしょうけど。それでも、よろしくお願いします。"

msgid "…그리고, 저기. 사실 전에 이 자리에 있던 사람들이요—"
msgstr "…それと、あの。実は、前にこの持ち場にいた人たちなんですけど——"

msgid "…아니에요. 별거 아니에요. 그럼 먼저 갈게요."
msgstr "…いえ。なんでもないです。じゃあ、お先に失礼します。"

msgid "근무 수칙 바인더 수령 — [B]로 펼치기 (아직 p.0 · p.1뿐)"
msgstr "勤務規則バインダーを受領 — [B]で開く（まだ p.0 · p.1 のみ）"

msgid "첫 번째는 조명 분전반이에요. 사무실 문 바로 옆 벽. 분전반 옆에 수칙 2페이지가 꽂혀 있어요. 먼저 챙기세요."
msgstr "最初は照明分電盤です。事務室のドアのすぐ横の壁。分電盤の横に規則の2ページが挟んであります。先に取っておいてください。"

msgid "다음은 출발 전광판. 체크인 홀 북쪽 벽이요. 3페이지는 전광판 아래, 제어함 왼쪽 벽에 붙어 있어요."
msgstr "次は出発案内板。チェックインホールの北側の壁です。3ページは案内板の下、制御ボックスの左の壁に貼ってあります。"

msgid "마지막은 안내방송. 안내 데스크 콘솔이요. 4페이지는 콘솔 옆에 놓여 있어요."
msgstr "最後は案内放送。案内カウンターのコンソールです。4ページはコンソールの横に置いてあります。"

msgid "[테스트 방송]을 눌러요. 문안은 수칙 4페이지랑 똑같아야 해요. 끝까지 듣고 보고하세요."
msgstr "[テスト放送 / 테스트 방송]を押してください。文案は規則の4ページと完全に同じでないといけません。最後まで聞いてから報告してください。"

msgid "근무 배정 확인 (사무실 PC)"
msgstr "勤務配置を確認（事務室のPC）"

msgid "사무실 서쪽 책상의 [b]PC[/b]에서 근무 배정을 확인하십시오."
msgstr "事務室西側の机の[b]PC[/b]で、勤務配置を確認してください。"

msgid "…같은 공고가, 매주 다시 올라왔다."
msgstr "…同じ求人が、毎週また掲載されていた。"

msgid "배정된 사물함 확인 (04)"
msgstr "割り当てられたロッカーを確認（04）"

msgid "사무실 북쪽 벽 [b]사물함 04[/b]의 이름표를 확인하십시오."
msgstr "事務室北側の壁にある[b]ロッカー04[/b]の名札を確認してください。"

msgid "이름표 밑에 이름표가… 몇 명째야."
msgstr "名札の下に、また名札が… 何人目なんだ。"

msgid "[b]저녁 근무자[/b]에게 돌아가 [E]로 근무 장비를 받으십시오."
msgstr "[b]遅番スタッフ[/b]のところへ戻り、[E]で勤務用の機材を受け取ってください。"

msgid "교대 근무자에게 장비 받기"
msgstr "交代勤務者から機材を受け取る"

msgid "팩스로 온 수칙 p.9 챙기기"
msgstr "ファックスで届いた規則 p.9を取る"

msgid "시설관리실 [b]팩스[/b] 옆에 소장이 보낸 수칙 9페이지(비상 수칙)가 있습니다. 퇴근 전에 챙기십시오."
msgstr "施設管理室の[b]ファックス[/b]の横に、所長が送った規則の9ページ（非常時規則）があります。退勤する前に取っておいてください。"

msgid "교대 근무자님, 퇴근 기록 아직이에요? 시간 지났어요."
msgstr "交代勤務者さん、退勤の打刻はまだですか？ 時間、過ぎてますよ。"

msgid "그리고 방금 그분이 하려던 말은 신경 쓰지 마세요. 여기선 쓸데없는 데 관심 두는 사람이 오래 못 가요."
msgstr "それと、さっきあの人が言いかけたことは気にしないでください。ここでは、余計なことに首を突っ込む人は長続きしませんから。"

msgid "다음은 바인더. [B]로 펼쳐요. 아직 0페이지 목차랑 1페이지 총칙뿐이죠? 1페이지는 꼭 읽어 두세요."
msgstr "次はバインダー。[B]で開いてください。まだ0ページの目次と1ページの総則だけですよね？ 1ページは必ず読んでおいてください。"

msgid "좋아요. 이제 점검이에요. 태블릿에 지시가 하나씩 떠요. 오늘은 여덟 번. 시설마다 그 시설 수칙 페이지가 있으니까, 챙겨서 바인더에 끼우고 시작해요."
msgstr "いいですね。ここからが点検です。タブレットに指示がひとつずつ出ます。今日は八回。施設ごとにその施設の規則ページがあるので、取ってバインダーに挟んでから始めてください。"

msgid "곧 세 시 정기 방송이에요. 비상 수칙 9페이지는 방금 사무실 팩스로 보냈어요. 이따 챙기고요."
msgstr "もうすぐ3時の定時放送です。非常時規則の9ページは、さっき事務室のファックスに送りました。後で取っておいてください。"

msgid "지금은 이것만 기억해요. 9페이지 3번 — 방송이 끝날 때까지 그 자리에서 움직이지 마세요."
msgstr "今はこれだけ覚えておいてください。9ページの3番——放送が終わるまで、その場から動かないでください。"

msgid "잘했어요. 정기 방송은 매일 세 시에 나와요. 날짜랑 시각을 알려 주니까 잘 들어 두세요."
msgstr "よくできました。定時放送は毎日3時に流れます。日付と時刻を知らせてくれるので、よく聞いておいてください。"

msgid "…A0, 23시 40분? 저런 편이 있었나."
msgstr "…A0、23時40分？ あんな便、あったか。"

msgid "왔어요? 하루 버티셨네요. 오늘부터 수하물도 보시죠. B-03 제어대가 여기예요."
msgstr "来ましたね。一日、乗り切ったんですね。今日から手荷物も担当でしょう？ B-03の制御盤はここです。"

msgid "아, 그리고 분실물 보관함. 동쪽 끝 자재창고에 있는데, 하루 한 번 열어 보래요. 개장 전이라 비어 있을 거예요."
msgstr "あ、それと遺失物保管庫。東の端の資材倉庫にあるんですけど、一日一回は開けて見るように、だそうです。開港前なので、空っぽのはずですよ。"

msgid "창고 얘기는 소장님한테 굳이 안 하셔도 돼요. …그럼 먼저 갈게요. 오늘도 수칙 꼭 지키세요."
msgstr "倉庫のことは、所長にわざわざ言わなくていいですよ。…じゃあ、お先に失礼します。今日も規則、ちゃんと守ってくださいね。"

msgid "분실물 보관함 확인 (자재창고)"
msgstr "遺失物保管庫を確認（資材倉庫）"

msgid "교대 근무자가 맡긴 일: 체크인 홀 동쪽 끝 [b]자재창고[/b]의 분실물 보관함을 열어 확인하십시오."
msgstr "交代勤務者に頼まれた仕事：チェックインホール東端の[b]資材倉庫[/b]にある遺失物保管庫を開けて確認してください。"

msgid "1987년 11월 3일…? 개장도 안 한 공항에, 39년 전 비행기표가 분실물로?"
msgstr "1987年11月3日…？ 開港もしていない空港に、39年前の航空券が落とし物として？"

msgid "…아까 창고 앞 복도 구석에, 동판 같은 게 서 있었는데."
msgstr "…さっき、倉庫の前の廊下の隅に、銅板みたいなものが立ってたな。"

msgid "창고 앞 복도의 동판 살펴보기"
msgstr "倉庫前の廊下の銅板を調べる"

msgid "자재창고로 가는 복도 구석에 [b]녹슨 동판[/b]이 세워져 있습니다. 살펴보십시오."
msgstr "資材倉庫へ向かう廊下の隅に、[b]錆びた銅板[/b]が立てられています。調べてください。"

msgid "같은 날짜다. 1987년 11월, A0편… 41명."
msgstr "同じ日付だ。1987年11月、A0便… 41名。"

msgid "A0편 기록 찾아보기 (사무실 PC)"
msgstr "A0便の記録を調べる（事務室のPC）"

msgid "A0편에 대해 알아보십시오. 시설관리실 [b]PC[/b]에서 사내 문서를 검색할 수 있습니다."
msgstr "A0便について調べてください。施設管理室の[b]PC[/b]で社内文書を検索できます。"

msgid "보고서는 비어 있고, 나머지는 열람 금지… 기록이 없는 게 아니다. 누가 막아 둔 거다."
msgstr "報告書は空っぽで、残りは閲覧禁止… 記録がないんじゃない。誰かが封じているんだ。"

msgid "…비행기표랑 같은 날짜, 같은 시각이다."
msgstr "…あの航空券と同じ日付、同じ時刻だ。"

msgid "어제 분실물 보관함 열어 보셨어요? …아뇨, 저는 열어 본 적 없어요. 그냥 물어본 거예요."
msgstr "昨日、遺失物保管庫、開けてみました？ …いえ、私は開けたことないです。ちょっと聞いてみただけです。"

msgid "사흘째네요. 먼저 들어갈게요."
msgstr "三日目ですね。お先に失礼します。"

msgid "소장님. 자재창고 이관 설비 상자에서 테이프가 하나 나왔는데요."
msgstr "所長。資材倉庫の移管設備の箱から、テープが一本出てきたんですが。"

msgid "…자재창고요? 그쪽에 창고가 있어요? 제 도면엔 그냥 벽인데요."
msgstr "…資材倉庫？ そっちに倉庫なんてあるんですか？ 私の図面だと、ただの壁なんですが。"

msgid "거길 어떻게 찾아 들어갔어요? 누가 알려 줬어요?"
msgstr "どうやってそこを見つけて入ったんですか？ 誰かに教わったんですか？"

msgid "콘솔 진단 화면에 위치가 나와 있었어요. 테이프엔 날짜가 적혀 있고요. 87년 11월 3일, A0…"
msgstr "コンソールの診断画面に場所が出ていました。テープには日付が書いてあって。87年11月3日、A0…"

msgid "…그건 됐고요."
msgstr "…それはもういいです。"

msgid "하나만 말할게요. 그 테이프, 다시는 틀지 마세요. 끊긴 데서 끝나는 게 맞아요."
msgstr "一つだけ言っておきます。そのテープ、二度と再生しないでください。途切れたところで終わるのが正しいんです。"

msgid "그 너머를 들으면, 저쪽에서도 당신을 듣게 돼요. 이름 같은 건 더더욱 말하지 말고요. …점검 계속하세요."
msgstr "その先を聞いたら、向こうにもあなたが聞こえるようになります。名前なんかは、なおさら口にしないでください。…点検を続けてください。"

msgid "안내 데스크 PA 콘솔에서 경고음이 울린다."
msgstr "案内カウンターのPAコンソールから警告音が鳴っている。"

msgid "콘솔 경고 표시 확인"
msgstr "コンソールの警告表示を確認"

msgid "PA 콘솔 경고 확인"
msgstr "PAコンソールの警告を確認"

msgid "체크인 홀 [b]안내 데스크 PA 콘솔[/b]에 경고가 들어왔습니다. 콘솔의 진단 표시를 확인하십시오."
msgstr "チェックインホールの[b]案内カウンターのPAコンソール[/b]に警告が出ました。コンソールの診断表示を確認してください。"

msgid "예비 앰프 모듈 가져오기 (자재창고)"
msgstr "予備アンプモジュールを持ってくる（資材倉庫）"

msgid "[b]자재창고[/b]의 이관 설비 상자에서 예비 앰프 모듈(AMP-2)을 꺼내 오십시오."
msgstr "[b]資材倉庫[/b]の移管設備の箱から、予備アンプモジュール（AMP-2）を取ってきてください。"

msgid "A0, 87.11.03… 비행기표랑 같은 날짜다. 그리고 방송 콘솔이 — 그때 그 비행장 거라고?"
msgstr "A0、87.11.03… あの航空券と同じ日付だ。それに放送コンソールが — あの時の、あの飛行場のものだって？"

msgid "예비 앰프 모듈 끼우기"
msgstr "予備アンプモジュールを差し込む"

msgid "SPK-07 출력 복구. 콘솔이 다시 시작됐다."
msgstr "SPK-07の出力が復旧。コンソールが再起動した。"

msgid "PA 콘솔에 앰프 모듈 끼우기"
msgstr "PAコンソールにアンプモジュールを差し込む"

msgid "[b]안내 데스크 PA 콘솔[/b]의 데크 쪽 모듈 칸에 예비 앰프 모듈을 끼우십시오."
msgstr "[b]案内カウンターのPAコンソール[/b]のデッキ側にあるモジュールスロットに、予備アンプモジュールを差し込んでください。"

msgid "콘솔에 테이프 데크가 달려 있다. …한번 틀어 볼까."
msgstr "コンソールにテープデッキが付いている。…一度、かけてみるか。"

msgid "테이프 넣고 재생"
msgstr "テープを入れて再生"

msgid "테이프 재생해 보기"
msgstr "テープを再生してみる"

msgid "PA 콘솔 왼쪽의 [b]테이프 데크[/b]에 카세트테이프를 넣고 재생하십시오."
msgstr "PAコンソール左側の[b]テープデッキ[/b]にカセットテープを入れて、再生してください。"

msgid "예비 앰프 모듈과 카세트테이프 한 개를 꺼냈다. 테이프 라벨: A0 / 87.11.03"
msgstr "予備アンプモジュールと、カセットテープを一本取り出した。テープのラベル：A0 / 87.11.03"

msgid "A0… 떠났다고? 지금 그런 편은 없는데."
msgstr "A0… 出発した？ 今、そんな便はないのに。"

msgid "퇴근 기록을 찍는 순간, 안내 데스크 쪽 스피커에서 테이프 감기는 소리가 났다."
msgstr "退勤を打刻した瞬間、案内カウンターの方のスピーカーから、テープを巻く音がした。"

msgid "콘솔의 테이프 데크는 비어 있었다."
msgstr "コンソールのテープデッキは、空だった。"

msgid "사무실 서랍이요? …그거 제가 열어 둔 거 아니에요."
msgstr "事務室の引き出しですか？ …あれ、私が開けておいたんじゃないですよ。"

msgid "책상 옆 서랍 하나가 반쯤 열려 있다."
msgstr "机の横の引き出しが一つ、半分開いている。"

msgid "열린 서랍 확인"
msgstr "開いた引き出しを確認"

msgid "시설관리실 책상 옆 [b]서랍[/b]이 열려 있습니다. 확인하십시오."
msgstr "施設管理室の机の横の[b]引き出し[/b]が開いています。確認してください。"

msgid "발견물 없음… 이륙했는지도 모른다고? 비행기가 떴는지조차?"
msgstr "発見物なし… 離陸したかどうかも分からないって？ 飛行機が飛んだのかさえ？"

msgid "스크랩 사이에서 공문 한 장이 미끄러져 나왔다."
msgstr "切り抜きの間から、公文書が一枚すべり落ちた。"

msgid "안내 데스크 쪽 스피커에서 테이프 감기는 소리가 난다."
msgstr "案内カウンターの方のスピーカーから、テープを巻く音がする。"

msgid "…방금 그거, 그 테이프죠. 틀지 말라고 했잖아요."
msgstr "…今のは、あのテープですよね。再生しないでって言ったでしょう。"

msgid "…안 틀었다고요? 그럼, 누가."
msgstr "…再生していない？ じゃあ、誰が。"

msgid "바닷물 냄새… 창고 분실물 보관함, 그 비행기표."
msgstr "海水の匂い… 倉庫の遺失物保管庫、あの航空券。"

msgid "분실물 보관함 다시 확인 (자재창고)"
msgstr "遺失物保管庫を再確認（資材倉庫）"

msgid "[b]자재창고[/b] 분실물 보관함의 1987년 탑승권을 다시 확인하십시오."
msgstr "[b]資材倉庫[/b]の遺失物保管庫にある1987年の搭乗券を、もう一度確認してください。"

msgid "수색에선 아무것도 못 찾았는데… 바다에서 못 찾은 것들이, 여기로 돌아오고 있다."
msgstr "捜索では何も見つからなかったのに… 海で見つからなかったものが、ここに戻ってきている。"

msgid "마지막 근무네요. 닷새를 다 채운 분은… 처음 봐요."
msgstr "最後の勤務ですね。五日間やり遂げた人は… 初めて見ました。"

msgid "오늘이 개장일이에요."
msgstr "今日が開港日です。"

msgid "탑승권 — FLIGHT A0"
msgstr "搭乗券 — FLIGHT A0"

msgid "PASSENGER　%s\nFLIGHT　A0\nFROM　SEOHAE · 서해\nTO　HOME · 집\nGATE　0\nBOARDING　23:40\nSEAT　—\n\n탑승이 확인되었습니다."
msgstr "PASSENGER　%s\nFLIGHT　A0\nFROM　SEOHAE · 西海\nTO　HOME · 家\nGATE　0\nBOARDING　23:40\nSEAT　—\n\n搭乗が確認されました。"

msgid "[송출 중지]가 듣지 않는다. 테이프가 계속 돈다."
msgstr "[送出停止 / 송출 중지]が効かない。テープが回り続けている。"

msgid "추　모\n1987. 11.\n서해비행장 A0편\n탑승객 41명"
msgstr "追　悼\n1987. 11.\n西海飛行場 A0便\n乗客41名"

msgid "PC 화면 보기"
msgstr "PCの画面を見る"

msgid "사물함 04 이름표 보기"
msgstr "ロッカー04の名札を見る"

msgid "서랍 열어 보기"
msgstr "引き出しを開けてみる"

msgid "분실물 보관함  LOST & FOUND"
msgstr "遺失物保管庫  LOST & FOUND"

msgid "분실물 보관함 열어 보기"
msgstr "遺失物保管庫を開けてみる"

msgid "구 서해비행장 이관 설비\n재사용 · 2025. 03."
msgstr "旧西海飛行場 移管設備\n再使用 · 2025. 03."

msgid "이관 장비 상자 열어 보기"
msgstr "移管設備の箱を開けてみる"

# --- chapter titles ---

msgid "DAY 1 — 첫 근무 · 또 새로 오신 분"
msgstr "DAY 1 — 初勤務 · また新しい人"

msgid "DAY 2 — 수하물 수취대 · 1987년의 비행기표"
msgstr "DAY 2 — 手荷物受取所 · 1987年の航空券"

msgid "DAY 3 — 보안검색 · A0 / 87.11.03"
msgstr "DAY 3 — 保安検査 · A0 / 87.11.03"

msgid "DAY 4 — 탑승동 · 젖은 물건들"
msgstr "DAY 4 — 搭乗棟 · 濡れたものたち"

